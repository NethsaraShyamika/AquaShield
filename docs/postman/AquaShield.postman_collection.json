{
  "info": {
    "name": "AquaShield API",
    "description": "Postman collection for AquaShield REST API (Users, Species, Reports, Cases).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET / (health)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "POST /api/users (register)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "POST /api/users/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.token) pm.collectionVariables.set('token', json.token);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/users (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "PUT /api/users/me (update profile)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "firstName", "value": "Updated", "type": "text" },
                { "key": "lastName", "value": "User", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Species",
      "item": [
        {
          "name": "GET /api/species",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/species",
              "host": ["{{baseUrl}}"],
              "path": ["api", "species"]
            }
          }
        },
        {
          "name": "GET /api/species/find (filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/species/find?bodyShape=&tailShape=&finType=&colorPattern=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "species", "find"],
              "query": [
                { "key": "bodyShape", "value": "" },
                { "key": "tailShape", "value": "" },
                { "key": "finType", "value": "" },
                { "key": "colorPattern", "value": "" }
              ]
            }
          }
        },
        {
          "name": "GET /api/species/gbif/search?q=shark",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/species/gbif/search?q=shark",
              "host": ["{{baseUrl}}"],
              "path": ["api", "species", "gbif", "search"],
              "query": [{ "key": "q", "value": "shark" }]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "GET /api/reports/my",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reports/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "my"]
            }
          }
        },
        {
          "name": "GET /api/reports (admin, paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/reports?page=1&limit=10&status=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cases",
      "item": [
        {
          "name": "GET /api/cases (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/cases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases"]
            }
          }
        }
      ]
    }
  ]
}
